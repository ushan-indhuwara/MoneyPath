# MoneyPath AI Environment Variables

# Set to true to enable server-side AI explanation generation
AI_ENABLED=false

# Optional API keys for AI explanations (Provider neutral server-side key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Site Metadata Configuration
NEXT_PUBLIC_SITE_URL=https://moneypathai.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=US
