# MoneyPath AI Environment Variables

# AI explanations are disabled unless explicitly enabled and an OpenAI key is configured.
AI_ENABLED=false

# Optional server-side OpenAI API key (never expose with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Site Metadata Configuration
NEXT_PUBLIC_SITE_URL=https://moneypathai.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=US

# Optional Google Analytics measurement ID. Analytics scripts load only after a visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
